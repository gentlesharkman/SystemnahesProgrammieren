for(int i = 1; i < height; i++){
    for(int j = 1; j < width; j++){
        for(int l = -1;l < 2; l++){
            int offset = (l * width)
            int curPxl = j + (i * width)
            int adjacent;
            for(int k = -1;k < 2; k++){
                if(k == 0 && l == 0){
                    val += pixel_data[curPxl] * 8;
                }else{
                    adjacent = curPxl + offset + k;
                    val += pixel_data[adjacent] * -1;
                }
            }
        }
    }
}